{
  "name": "grizzly",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "turbo run dev --filter=@grizzly/api",
    "dev:web": "turbo run dev --filter=@grizzly/web",
    "build:api": "turbo run build --filter=@grizzly/api",
    "build:web": "turbo run build --filter=@grizzly/web"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  }
}
